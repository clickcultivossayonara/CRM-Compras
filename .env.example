# Copiar a .env y completar. Nunca versionar .env.
DATABASE_URL=
# Solo pruebas de integración: se borra y se migra en cada corrida. Nunca la base real.
TEST_DATABASE_URL=
# Firma la cookie de sesión: al menos 32 caracteres aleatorios (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
# 1 (por defecto): cookie solo por HTTPS. 0 únicamente para pruebas locales por HTTP.
CRM_COOKIES_SEGURAS=1
SYNC_TOKEN=
SOFTLAND_SERVIDOR=
SOFTLAND_BASE=SAYOERP
SOFTLAND_USUARIO=
SOFTLAND_CLAVE=
